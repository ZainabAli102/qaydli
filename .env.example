# Supabase — project URL and keys (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by /api/scan and admin tasks.
SUPABASE_SERVICE_ROLE_KEY=

# Extraction providers
# OpenAI is the default vision provider for the engine.
OPENAI_API_KEY=
# Vision model to use (default: gpt-4o). e.g. gpt-4o, gpt-4.1, gpt-5.6-sol.
OPENAI_MODEL=gpt-4o
# Speech-to-text for voice input on the Describe boxes.
# Primary provider is ElevenLabs Scribe (best coverage for ar + Central Kurdish);
# OpenAI is the fallback if ElevenLabs errors. Override per-request for A/B tests
# with /api/transcribe?provider=elevenlabs|openai.
ELEVENLABS_API_KEY=
# ElevenLabs Scribe model (default: scribe_v1). e.g. scribe_v1, scribe_v1_experimental.
ELEVENLABS_TRANSCRIBE_MODEL=scribe_v1
# OpenAI fallback model (default: whisper-1). e.g. whisper-1, gpt-4o-mini-transcribe.
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Opt-in: bias transcription toward each business's own vendor/client/item names
# (a per-business word list). Off by default because the keyterm field is only
# accepted on some plans/models; leave unset unless you have confirmed support.
ELEVENLABS_BIASING=
# Anthropic is optional (stub adapter in phase 0).
ANTHROPIC_API_KEY=

# Learning loop
# Admin token guarding GET /api/admin/accuracy (learning-loop metrics across all
# businesses). Set a long random value; requests must send it as x-admin-token,
# Authorization: Bearer <token>, or ?token=. Leave unset to disable the endpoint.
ADMIN_TOKEN=

# Money
# Books are kept in IQD. USD is shown alongside using this rate.
BASE_CURRENCY=IQD
USD_IQD_RATE=1310

# Invoice PDFs are rendered with @react-pdf/renderer (no browser/Chromium
# needed), so there is no PDF-specific env var to set.
