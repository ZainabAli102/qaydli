# Supabase — project URL and keys (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by /api/scan and admin tasks.
SUPABASE_SERVICE_ROLE_KEY=

# Extraction providers
# OpenAI is the default vision provider for the engine.
OPENAI_API_KEY=
# Vision model to use (default: gpt-4o). e.g. gpt-4o, gpt-4.1, gpt-5.6-sol.
OPENAI_MODEL=gpt-4o
# Anthropic is optional (stub adapter in phase 0).
ANTHROPIC_API_KEY=

# Money
# Books are kept in IQD. USD is shown alongside using this rate.
BASE_CURRENCY=IQD
USD_IQD_RATE=1310

# Invoice PDF generation (optional).
# Path to a Chromium binary used to render invoice PDFs. In dev the bundled
# Playwright Chromium is auto-detected; on Vercel point this at a serverless
# Chromium (e.g. @sparticuz/chromium). Without it the public /i/<token> page
# and WhatsApp share still work; only the PDF download is unavailable.
CHROMIUM_EXECUTABLE_PATH=
